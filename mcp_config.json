{
  "mcpServers": {
    "colab-mcp": {
      "command": "uv",
      "args": [
        "tool",
        "run",
        "--from",
        "git+https://github.com/googlecolab/colab-mcp",
        "colab-mcp"
      ],
      "env": {
        "UV_SYSTEM_CERTS": "true"
      },
      "timeout": 120000
    }
  }
}
